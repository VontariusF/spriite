{
  "name": "spriite",
  "private": true,
  "version": "0.2.0",
  "description": "Voice-first companion for running an AI software factory (Factory, Cursor) from HUD smart glasses. Bring your own keys; self-hosted relay.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:copy": "node scripts/measure-copy.mjs",
    "test:real": "node --import ./scripts/ts-resolve.mjs scripts/real-engine-test.mjs",
    "sheet": "node scripts/contact-sheet.mjs",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1\" --automation-port 9898",
    "walkthrough": "node scripts/walkthrough.mjs",
    "pack": "npm run check:copy && npm run build && node scripts/pack.mjs spriite.ehpk",
    "relay": "node relay/node.mjs"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.1.14",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "keywords": [
    "smart-glasses",
    "hud",
    "ai-agents",
    "factory",
    "cursor",
    "voice",
    "even-realities"
  ]
}
