    "sim:offline": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake=1&flags=-persistent_runtime_v2&fake-goal=Deliver%20the%20empty-state%20screen&fake-offline=1&fake-askpr=1&fake-phone=now\" --automation-port 9899",
    "sim:blocked": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake=1&flags=-persistent_runtime_v2&fake-norepo=1&fake-nogithub=1&fake-goal=Deliver%20the%20empty-state%20screen\" --automation-port 9900",
    "sim:newrepo": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake=1&flags=-persistent_runtime_v2&fake-norepo=1&fake-goal=Build%20a%20landing%20page%20for%20Acme&fake-phone=now\" --automation-port 9901",
    "sim:runtime": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake=1&flags=persistent_runtime_v2&fake-goal=Deliver%20the%20empty-state%20screen&fake-offline=1&fake-askpr=1&fake-phone=now\" --automation-port 9903",
    "sim:question": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake=1&flags=-persistent_runtime_v2&fake-goal=Deliver%20the%20empty-state%20screen&fake-offline=1&fake-askpr=1&fake-question=1&fake-phone=now\" --automation-port 9904",
