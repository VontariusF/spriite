    "walk:runtime": "node scripts/walkthrough-runtime.mjs",
    "walk:session-options": "node scripts/walkthrough-session-options.mjs",
    "walk:native": "node scripts/walkthrough-native.mjs",
    "sim:native": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js \"http://localhost:5173/?fresh=1&fake-native=1&flags=persistent_runtime_v2&fake-phone=now&fake-native-channel=9916\" --automation-port 9916",
    "qualify": "node scripts/qualify.mjs",
    "pack": "npm run check:copy && npm run build && node scripts/pack.mjs spriite.ehpk",
    "relay": "node relay/node.mjs",
    "install:native-broker": "bash scripts/install-native-broker.sh",
    "pair": "node cli/bin/spriite.mjs pair"
