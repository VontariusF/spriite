# Copy to .env.production.local (git-ignored) and fill in, then `npm run pack`.

# Required: the https URL of the relay you deployed (relay/README.md).
# It may be mounted under a path, e.g. https://example.com/spriite-relay
VITE_SPRIITE_RELAY=https://spriite-relay.<you>.workers.dev

# The package_id of the project you created in your Even Hub developer
# account. Package ids are unique per account, so pick your own.
SPRIITE_PACKAGE_ID=com.yourname.spriite

# Optional: the https URL of your native broker (Factory Missions on your
# Factory host: the Linux or macOS machine where droid runs), as printed by
# scripts/install-native-broker.sh, e.g. a tailnet-only `tailscale serve`
# address or your own TLS reverse proxy. Packed into the network allowlist so
# the phone can reach it. See docs/NATIVE-BROKER-SETUP.md.
# SPRIITE_NATIVE_BROKER=https://<your-factory-host>.<your-tailnet>.ts.net:47822
